@model Ecommerce_Website_MVC.Controllers.ShopViewModel
@{
    ViewBag.Title = "Collections | Show's Garage";
}
@section styles {
    <link rel="stylesheet" href="~/Assets/css/shop.css" />
}

<div class="shop-layout">
    <!-- Sidebar Filters -->
    <aside class="shop-sidebar">
        <div class="sidebar-section">
            <h4>Browse Categories</h4>
            <ul class="category-list">
                <li>
                    <a href="@Url.Action("Index", "Shop")"
                       class="cat-link @(Model.CategoryId == 0 && string.IsNullOrEmpty(Model.Search) ? "cat-active" : "")">
                        All Models
                    </a>
                </li>
                @foreach (var cat in Model.Categories)
                {
                    <li>
                        <a href="@Url.Action("Index", "Shop", new { categoryId = cat.CategoryId })"
                           class="cat-link @(Model.CategoryId == cat.CategoryId ? "cat-active" : "")">
                            @cat.CategoryName
                        </a>
                    </li>
                }
            </ul>
        </div>
    </aside>

    <!-- Product Grid -->
    <main class="shop-main">
        <div class="shop-header">
            <h2 class="page-header">
                @if (!string.IsNullOrEmpty(Model.Search))
                { <span>Results for "@Model.Search"</span> }
                else if (Model.CategoryId > 0)
                { <span>@((Model.Categories.Find(c => c.CategoryId == Model.CategoryId) != null ? Model.Categories.Find(c => c.CategoryId == Model.CategoryId).CategoryName : "Products"))</span> }
                else
                { <span>All Collections</span> }
            </h2>
            <span style="color:var(--text-muted);font-size:14px;">@Model.Products.Count item(s)</span>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="empty-state" style="text-align:center;padding:60px;">
                <p style="font-size:16px;color:var(--text-muted);">No products found matching your criteria.</p>
                <a href="@Url.Action("Index", "Shop")" class="buy-btn" style="display:inline-block;margin-top:15px;">View All</a>
            </div>
        }
        else
        {
            <div class="item-grid">
                @foreach (var p in Model.Products)
                {
                    <div class="car-card">
                        <a href="@Url.Action("Details", "Shop", new { id = p.ProductId })" style="text-decoration:none;color:inherit;">
                            <div style="height:220px;overflow:hidden;">
                                <img src="@Url.Content(string.IsNullOrEmpty(p.ImagePath) ? "~/Assets/images/default-model.png" : p.ImagePath)"
                                     alt="@p.Title" style="width:100%;height:100%;object-fit:cover;transition:transform .4s ease;"
                                     onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'"
                                     loading="lazy" />
                            </div>
                            <div class="car-info">
                                <p style="font-size:12px;color:var(--text-muted);margin:0 0 4px;">@p.BrandName</p>
                                <h4 style="font-size:15px;margin:0 0 8px;">@p.Title</h4>
                                @if (p.MRP > p.SellingPrice)
                                {
                                    <p style="margin:0;font-size:12px;color:var(--text-muted);text-decoration:line-through;">MRP Rs.@p.MRP.ToString("N0")</p>
                                }
                                <p class="car-price">Rs.@p.SellingPrice.ToString("N0")</p>
                                @if (p.StockQuantity == 0)
                                {
                                    <span style="color:#e50914;font-weight:600;font-size:13px;">Out of Stock</span>
                                }
                                else
                                {
                                    <span class="buy-btn" style="display:inline-block;">View Details</span>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </main>
</div>

