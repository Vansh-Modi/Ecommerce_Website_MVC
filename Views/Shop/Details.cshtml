@model Ecommerce_Website_MVC.Models.ProductModel
@{
    ViewBag.Title = Model.Title + " | Show's Garage";
    var gallery = ViewBag.GalleryImages as List<string> ?? new List<string>();
}
@section styles {
    <link rel="stylesheet" href="~/Assets/css/productDetails.css" />
}

<div class="details-max-width" style="padding: 20px 15px;">
    <div class="details-back-container">
        <a href="@Url.Action("Index", "Shop")" class="btn-layout-back">&larr; Back to Collections</a>
    </div>

    <div class="product-details-layout-container">
        <!-- Showcase Graphics Frame -->
        <div>
            <div class="main-showcase-image-frame">
                <img id="mainImage"
                     src="@Url.Content(string.IsNullOrEmpty(Model.ImagePath) ? "~/Assets/images/default-model.png" : Model.ImagePath)"
                     alt="@Model.Title" class="details-main-img" />
            </div>
            @if (gallery.Count > 0)
            {
                <div style="display:flex;gap:10px;margin-top:15px;overflow-x:auto;">
                    <img src="@Url.Content(string.IsNullOrEmpty(Model.ImagePath) ? "~/Assets/images/default-model.png" : Model.ImagePath)"
                         onclick="document.getElementById('mainImage').src=this.src"
                         style="width:70px;height:55px;object-fit:contain;border:1px solid rgba(0,0,0,0.1);border-radius:6px;cursor:pointer;padding:4px;" />
                    @foreach (var g in gallery)
                    {
                        <img src="@Url.Content(g)"
                             onclick="document.getElementById('mainImage').src=this.src"
                             style="width:70px;height:55px;object-fit:contain;border:1px solid rgba(0,0,0,0.1);border-radius:6px;cursor:pointer;padding:4px;" />
                    }
                </div>
            }
        </div>

        <!-- Details Info -->
        <div class="product-info-panel">
            <p style="color:var(--text-muted);text-transform:uppercase;font-size:12px;font-weight:700;letter-spacing:1px;margin:0 0 5px;">@Model.BrandName</p>
            <h1 style="font-family:'Montserrat',sans-serif;font-size:28px;font-weight:800;color:var(--text-main);margin:0 0 10px;">@Model.Title</h1>
            
            @if (!string.IsNullOrEmpty(Model.Scale))
            {
                <p style="color:var(--text-muted);font-size:14px;margin-bottom:15px;">Scale: <strong>@Model.Scale</strong></p>
            }

            <div style="display:flex;align-items:baseline;gap:15px;margin-bottom:20px;">
                <h2 style="font-family:'Montserrat',sans-serif;font-size:32px;font-weight:800;color:#e50914;margin:0;">Rs. @Model.SellingPrice.ToString("N0")</h2>
                @if (Model.MRP > Model.SellingPrice)
                {
                    <span style="text-decoration:line-through;color:var(--text-muted);font-size:16px;">MRP Rs. @Model.MRP.ToString("N0")</span>
                }
            </div>

            <div style="margin-bottom:20px;">
                @if (Model.StockQuantity > 0)
                {
                    <span style="background:#28a745;color:#fff;padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;display:inline-block;">In Stock (@Model.StockQuantity available)</span>
                }
                else
                {
                    <span style="background:#e50914;color:#fff;padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;display:inline-block;">Out of Stock</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div style="border-top:1px solid rgba(0,0,0,0.08);padding-top:20px;margin-top:20px;color:var(--text-main);font-size:14px;line-height:1.6;">
                    <p>@Html.Raw(Model.Description)</p>
                </div>
            }

            @if (Model.StockQuantity > 0)
            {
                using (Html.BeginForm("AddToCart", "Shop", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <div style="display:flex;align-items:center;gap:15px;margin-top:25px;">
                        <input type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity"
                               class="auth-input" style="width:80px;text-align:center;padding:12px;" />
                        <button type="submit" class="buy-btn" style="padding:14px 35px;font-size:15px;">Add to Cart</button>
                    </div>
                }
            }

            @if (TempData["CartSuccess"] != null)
            {
                <div style="color:#28a745;margin-top:15px;font-weight:600;">@TempData["CartSuccess"]</div>
            }
        </div>
    </div>
</div>
