@model Ecommerce_Website_MVC.Models.ReportModel
@{
    ViewBag.Title = "Reports | Admin";
}
@section styles {
    <link rel="stylesheet" href="~/Assets/css/admin_reports.css" />
}


<h2 class="page-header">Financial Reports</h2>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:35px;">
    @{
        void StatCard(string label, string value, string color = "var(--text-main)") {
            <div style="background:var(--card-bg);border-radius:10px;padding:22px;box-shadow:0 4px 14px rgba(0,0,0,.05);">
                <p style="font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:8px;">@label</p>
                <h2 style="font-size:28px;font-family:'Montserrat',sans-serif;color:@color;">@value</h2>
            </div>;
        }
    }
    @{ StatCard("Total Revenue",   "â‚¹" + Model.TotalRevenue.ToString("N2"),  "#28a745"); }
    @{ StatCard("Total Expenses",  "â‚¹" + Model.TotalExpenses.ToString("N2"), "#e50914"); }
    @{ StatCard("Net Profit",      "â‚¹" + Model.NetProfit.ToString("N2"),     Model.NetProfit >= 0 ? "#28a745" : "#e50914"); }
    @{ StatCard("MTD Revenue",     "â‚¹" + Model.MtdRevenue.ToString("N2"),    "#f0a500"); }
    @{ StatCard("Total Orders",    Model.TotalOrdersCount.ToString()); }
    @{ StatCard("Approved Orders", Model.ApprovedOrders.ToString(),  "#28a745"); }
    @{ StatCard("Cancelled",       Model.CancelledOrders.ToString(), "#e50914"); }
</div>

<div class="content-card">
    <h3 style="margin-bottom:20px;">Summary</h3>
    <table style="width:100%;border-collapse:collapse;">
        <tbody>
            <tr style="border-bottom:1px solid rgba(0,0,0,.07);"><td style="padding:12px;">Total Revenue (Approved Orders)</td><td style="text-align:right;padding:12px;font-weight:700;color:#28a745;">â‚¹@Model.TotalRevenue.ToString("N2")</td></tr>
            <tr style="border-bottom:1px solid rgba(0,0,0,.07);"><td style="padding:12px;">Total Expenses Recorded</td><td style="text-align:right;padding:12px;font-weight:700;color:#e50914;">â‚¹@Model.TotalExpenses.ToString("N2")</td></tr>
            <tr style="background:rgba(0,0,0,.03);"><td style="padding:12px;font-weight:700;">Net Profit</td><td style="text-align:right;padding:12px;font-weight:800;font-size:18px;color:@(Model.NetProfit>=0?"#28a745":"#e50914");">â‚¹@Model.NetProfit.ToString("N2")</td></tr>
        </tbody>
    </table>
</div>


