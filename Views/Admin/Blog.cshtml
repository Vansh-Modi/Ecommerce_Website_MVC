@model List<Ecommerce_Website_MVC.Models.BlogModel>
@{
    ViewBag.Title = "Manage Blog | Admin";
}
@section styles {
    <link rel="stylesheet" href="~/Assets/css/admin_blog.css" />
}


@if (TempData["Success"] != null) { <div style="background:#28a745;color:#fff;padding:12px 20px;border-radius:6px;margin-bottom:20px;">@TempData["Success"]</div> }

<div style="display:flex;gap:20px;flex-wrap:wrap;align-items:flex-start;">

    <!-- Blog Form -->
    <div class="content-card" style="flex:1;min-width:300px;" id="blogFormSection">
        <h3 id="blogFormTitle" style="margin-bottom:20px;">Publish New Blog</h3>
        @using (Html.BeginForm("SaveBlog","Admin",FormMethod.Post,new{enctype="multipart/form-data"}))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="blogId"           id="editBlogId" value="" />
            <input type="hidden" name="currentBlogImage" id="currentBlogImg" value="" />
            <div class="input-group"><label>Blog Title *</label><input type="text"  name="blogTitle" id="bTitle"  class="auth-input" required /></div>
            <div class="input-group"><label>Author</label><input type="text" name="author" id="bAuthor" class="auth-input" placeholder="Admin" /></div>
            <div class="input-group"><label>Excerpt</label><textarea name="excerpt"  id="bExcerpt" class="auth-input" rows="2"></textarea></div>
            <div class="input-group"><label>Content (HTML allowed)</label><textarea name="content"  id="bContent" class="auth-input" rows="8"></textarea></div>
            <div class="input-group"><label>Blog Image</label><input type="file" name="blogImage" accept=".jpg,.jpeg,.png,.webp" style="border:1px solid rgba(0,0,0,.15);border-radius:6px;padding:8px;width:100%;" /></div>
            <button type="submit" class="buy-btn" style="padding:11px 25px;">Publish</button>
            <button type="button" onclick="clearBlogForm()" style="margin-left:10px;padding:11px 20px;border:1px solid rgba(0,0,0,.15);border-radius:6px;background:transparent;cursor:pointer;">Clear</button>
        }
    </div>

    <!-- Blog List -->
    <div class="content-card" style="flex:2;min-width:320px;">
        <h3 style="margin-bottom:15px;">All Blogs (@Model.Count)</h3>
        @foreach (var b in Model)
        {
            <div style="display:flex;gap:15px;padding:12px 0;border-bottom:1px solid rgba(0,0,0,.07);align-items:center;">
                <img src="@Url.Content(string.IsNullOrEmpty(b.BlogImage)?"~/Assets/images/default-blog.png":b.BlogImage)"
                     style="width:70px;height:52px;object-fit:cover;border-radius:6px;flex-shrink:0;" />
                <div style="flex:1;">
                    <strong style="font-size:14px;">@b.BlogTitle</strong>
                    <p style="font-size:12px;color:var(--text-muted);margin:3px 0;">@b.PublishDate.ToString("dd MMM yyyy") - @b.Author</p>
                    <p style="font-size:12px;color:var(--text-muted);">@(!string.IsNullOrEmpty(b.Excerpt) && b.Excerpt.Length > 80 ? b.Excerpt.Substring(0, 80) + "..." : b.Excerpt)</p>
                </div>
                <div style="display:flex;gap:6px;flex-shrink:0;">
                    <button type="button" onclick="editBlog(@b.BlogId,'@Html.Raw(b.BlogTitle != null ? b.BlogTitle.Replace("'","\\'") : "")','@Html.Raw(b.Author != null ? b.Author.Replace("'","\\'") : "")','@Html.Raw(b.Excerpt != null ? b.Excerpt.Replace("'","\\'") : "")','@Html.Raw(b.Content != null ? b.Content.Replace("'","\\'") : "")','@b.BlogImage')" class="buy-btn" style="padding:5px 12px;font-size:11px;">Edit</button>
                    @using (Html.BeginForm("DeleteBlog","Admin",FormMethod.Post,new{style="display:inline"}))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="blogId" value="@b.BlogId" />
                        <button type="submit" class="buy-btn" style="background:#e50914;padding:5px 12px;font-size:11px;" onclick="return confirm('Delete this blog?')">Del</button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        function editBlog(id,title,author,excerpt,content,img){
            document.getElementById('blogFormTitle').textContent = 'Edit Blog';
            document.getElementById('editBlogId').value   = id;
            document.getElementById('bTitle').value        = title;
            document.getElementById('bAuthor').value       = author;
            document.getElementById('bExcerpt').value      = excerpt;
            document.getElementById('bContent').value      = content;
            document.getElementById('currentBlogImg').value= img;
            document.getElementById('blogFormSection').scrollIntoView({behavior:'smooth'});
        }
        function clearBlogForm(){
            document.getElementById('blogFormTitle').textContent = 'Publish New Blog';
            document.getElementById('editBlogId').value   = '';
            document.getElementById('currentBlogImg').value= '';
            document.querySelectorAll('#blogFormSection input:not([type=hidden]),#blogFormSection textarea').forEach(function(el){el.value='';});
        }
    </script>
}




