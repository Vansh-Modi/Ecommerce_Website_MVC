@{
    ViewBag.Title = "Admin Dashboard | Show's Garage";
}
@section styles {
    <link rel="stylesheet" href="~/Assets/css/admin_dashboard.css" />
    <style>
        @@media (max-width: 768px) { .dash-grid { grid-template-columns: 1fr !important; } }
    </style>
}

<h2 class="page-header">Dashboard</h2>

<!-- Stats Cards -->
<div class="stats-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:35px;">
    <div class="stat-card" style="background:var(--card-bg);border-radius:10px;padding:22px;box-shadow:0 4px 14px rgba(0,0,0,.05);">
        <p style="font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:8px;">Awaiting Verification</p>
        <h2 style="font-size:36px;font-family:'Montserrat',sans-serif;color:#e50914;">@ViewBag.AwaitingVerify</h2>
    </div>
    <div class="stat-card" style="background:var(--card-bg);border-radius:10px;padding:22px;box-shadow:0 4px 14px rgba(0,0,0,.05);">
        <p style="font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:8px;">Total Products</p>
        <h2 style="font-size:36px;font-family:'Montserrat',sans-serif;">@ViewBag.TotalProducts</h2>
    </div>
    <div class="stat-card" style="background:var(--card-bg);border-radius:10px;padding:22px;box-shadow:0 4px 14px rgba(0,0,0,.05);">
        <p style="font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:8px;">Total Users</p>
        <h2 style="font-size:36px;font-family:'Montserrat',sans-serif;">@ViewBag.TotalUsers</h2>
    </div>
    <div class="stat-card" style="background:var(--card-bg);border-radius:10px;padding:22px;box-shadow:0 4px 14px rgba(0,0,0,.05);">
        <p style="font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:8px;">Support Tickets</p>
        <h2 style="font-size:36px;font-family:'Montserrat',sans-serif;">@ViewBag.TotalSupportTickets</h2>
    </div>
    <div class="stat-card" style="background:#e50914;border-radius:10px;padding:22px;color:#fff;">
        <p style="font-size:12px;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;opacity:.85;">MTD Revenue</p>
        <h2 style="font-size:28px;font-family:'Montserrat',sans-serif;">â‚¹@ViewBag.MtdRevenue</h2>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:30px;flex-wrap:wrap;" class="dash-grid">

    <!-- Recent Orders -->
    <div class="content-card">
        <h3 style="margin-bottom:15px;font-family:'Montserrat',sans-serif;">Recent Orders</h3>
        @{
            var recentOrders = ViewBag.RecentOrders as List<Ecommerce_Website_MVC.Models.OrderModel>;
        }
        @if (recentOrders != null && recentOrders.Any())
        {
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="background:rgba(0,0,0,.04);">
                        <th style="padding:8px;text-align:left;font-size:12px;">Order #</th>
                        <th style="padding:8px;text-align:left;font-size:12px;">Date</th>
                        <th style="padding:8px;text-align:left;font-size:12px;">Amount</th>
                        <th style="padding:8px;text-align:left;font-size:12px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in recentOrders)
                    {
                        <tr style="border-bottom:1px solid rgba(0,0,0,.06);">
                            <td style="padding:8px;">#@o.OrderId</td>
                            <td style="padding:8px;">@o.OrderDate.ToString("dd MMM")</td>
                            <td style="padding:8px;">â‚¹@o.TotalAmount.ToString("N0")</td>
                            <td style="padding:8px;">
                                <span style="color:@(o.Status=="Approved"?"#28a745":o.Status=="Cancelled"?"#e50914":"#f0a500");font-weight:600;">@o.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <a href="@Url.Action("Orders","Admin")" style="display:inline-block;margin-top:12px;font-size:13px;color:#e50914;">View All Orders â†’</a>
        }
        else { <p style="color:var(--text-muted);">No orders yet.</p> }
    </div>

    <!-- Low Stock -->
    <div class="content-card">
        <h3 style="margin-bottom:15px;font-family:'Montserrat',sans-serif;">Low Stock Alert</h3>
        @{
            var lowStock = ViewBag.LowStock as List<Ecommerce_Website_MVC.Models.ProductModel>;
        }
        @if (lowStock != null && lowStock.Any())
        {
            foreach (var p in lowStock)
            {
                <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(0,0,0,.06);">
                    <span style="font-size:14px;">@p.BrandName â€” @p.Title <span style="color:var(--text-muted);font-size:12px;">(@p.Scale)</span></span>
                    <strong style="color:@(p.StockQuantity==0?"#e50914":"#f0a500");">@p.StockQuantity left</strong>
                </div>
            }
        }
        else { <p style="color:var(--text-muted);">All products well stocked!</p> }
    </div>
</div>







