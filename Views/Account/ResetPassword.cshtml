@{
    ViewBag.Title = "Set New Password | Show's Garage";
}
@section styles {
    <link rel="stylesheet" href="~/Assets/css/login.css" />
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Set New Password</h2>
            <p>Enter the OTP received in your inbox and update credentials</p>
        </div>
        @if (TempData["ForgotSuccess"] != null)
        {
            <div style="color:#28a745;font-size:13px;text-align:center;margin-bottom:12px;">@TempData["ForgotSuccess"]</div>
        }
        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="auth-form">
                <div class="input-group">
                    <label>6-Digit Verification Code</label>
                    <input type="text" name="otp" class="auth-input" placeholder="Ex: 123456" maxlength="6" required />
                </div>
                <div class="input-group">
                    <label>New Password</label>
                    <input type="password" name="newPass" class="auth-input" placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢" required />
                </div>
                <button type="submit" class="auth-btn">UPDATE PASSWORD</button>
                @if (ViewBag.Error != null && !string.IsNullOrEmpty(ViewBag.Error.ToString()))
                {
                    <div style="color:#e50914;font-size:13px;margin-top:10px;">@ViewBag.Error</div>
                }
                <div class="auth-footer">
                    <p><a href="@Url.Action("Login", "Account")" style="color:#bbb;">Cancel and Back</a></p>
                </div>
            </div>
        }
    </div>
</div>

