@{
    ViewBag.Title = "Recover Password | Show's Garage";
}
@section styles {
    <link rel="stylesheet" href="~/Assets/css/login.css" />
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Recover Password</h2>
            <p>Enter your email to receive a recovery code</p>
        </div>
        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="auth-form">
                <div class="input-group">
                    <label>Registered Email Address</label>
                    <input type="email" name="forgotEmail" class="auth-input" placeholder="name@email.com" required />
                </div>
                <button type="submit" class="auth-btn">SEND OTP</button>

                @if (ViewBag.Error != null && !string.IsNullOrEmpty(ViewBag.Error.ToString()))
                {
                    <div style="color:#e50914;font-size:13px;margin-top:10px;">@ViewBag.Error</div>
                }
                <div class="auth-footer">
                    <p><a href="@Url.Action("Login", "Account")" style="color:#bbb;">Back to Login</a></p>
                </div>
            </div>
        }
    </div>
</div>

