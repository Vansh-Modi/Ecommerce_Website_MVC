@model List<Ecommerce_Website_MVC.Models.CartItemModel>
@{
    ViewBag.Title = "My Cart | Show's Garage";
    decimal total = Model.Sum(i => i.LineTotal);
}
@section styles {
    <link rel="stylesheet" href="~/Assets/css/cart.css" />
}

<div class="shop-content-container">
    <div class="shop-controls-bar">
        <h1 class="shop-main-heading">Shopping Cart (@Model.Count)</h1>
        <a href="@Url.Action("Index","Shop")" class="btn-filter-pill">&larr; Continue Shopping</a>
    </div>

    @if (TempData["CartError"] != null)
    {
        <div style="background:#e50914;color:#fff;padding:12px 20px;border-radius:6px;margin-bottom:20px;">@TempData["CartError"]</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-cart" style="text-align:center;padding:80px 20px;background:var(--card-bg);border-radius:12px;">
            <h2 style="font-family:'Montserrat',sans-serif;color:var(--text-main);">Your cart is empty</h2>
            <p style="color:var(--text-muted);margin:15px 0 25px;">Looks like you haven't added anything yet.</p>
            <a href="@Url.Action("Index","Shop")" class="buy-btn" style="padding:12px 30px;">Shop Now</a>
        </div>
    }
    else
    {
        <div class="cart-layout-container">
            <!-- Left Column: Items -->
            <div class="cart-items-column">
                @foreach (var item in Model)
                {
                    <div class="cart-item-row">
                        <div class="cart-item-image-frame">
                            <img src="@Url.Content(string.IsNullOrEmpty(item.ImagePath) ? "~/Assets/images/default-model.png" : item.ImagePath)"
                                 alt="@item.Title" class="cart-item-img" style="width:100%;height:100%;object-fit:contain;" />
                        </div>
                        <div style="flex:1;">
                            <p style="color:var(--text-muted);font-size:11px;font-weight:700;text-transform:uppercase;margin:0 0 4px;">@item.BrandName</p>
                            <h4 style="font-family:'Montserrat',sans-serif;font-size:16px;margin:0 0 6px;color:var(--text-main);">@item.Title</h4>
                            <p style="color:#e50914;font-weight:700;margin:0;">Rs. @item.SellingPrice.ToString("N0") each</p>
                        </div>
                        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="action" value="minus" />
                                <button type="submit" style="background:rgba(0,0,0,0.06);border:none;width:30px;height:30px;border-radius:50%;cursor:pointer;font-weight:700;color:var(--text-main);">-</button>
                            }
                            <span style="font-weight:700;font-size:15px;min-width:20px;text-align:center;color:var(--text-main);">@item.Quantity</span>
                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="action" value="plus" />
                                <button type="submit" style="background:rgba(0,0,0,0.06);border:none;width:30px;height:30px;border-radius:50%;cursor:pointer;font-weight:700;color:var(--text-main);">+</button>
                            }
                            @using (Html.BeginForm("RemoveItem", "Cart", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" style="background:#e50914;color:#fff;border:none;padding:6px 12px;border-radius:6px;font-size:12px;cursor:pointer;" onclick="return confirm('Remove this item?')">Remove</button>
                            }
                            <span style="font-weight:800;font-size:16px;color:var(--text-main);min-width:90px;text-align:right;">Rs. @item.LineTotal.ToString("N0")</span>
                        </div>
                    </div>
                }
            </div>

            <!-- Right Column: Summary Box -->
            <div style="flex:1;max-width:380px;width:100%;">
                <div style="background:var(--card-bg);border:1px solid rgba(0,0,0,0.05);border-radius:12px;padding:25px;box-shadow:0 4px 14px rgba(0,0,0,0.02);">
                    <h3 style="font-family:'Montserrat',sans-serif;font-size:18px;margin:0 0 20px;text-transform:uppercase;color:var(--text-main);">Order Summary</h3>
                    <div style="display:flex;justify-content:space-between;margin-bottom:12px;color:var(--text-main);">
                        <span>Subtotal</span>
                        <span>Rs. @total.ToString("N0")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:15px;color:var(--text-muted);font-size:13px;">
                        <span>Shipping</span>
                        <span>Calculated at checkout</span>
                    </div>
                    <hr style="opacity:.15;margin:15px 0;" />
                    <div style="display:flex;justify-content:space-between;margin-bottom:20px;font-size:18px;color:var(--text-main);">
                        <strong>Total</strong>
                        <strong style="color:#e50914;">Rs. @total.ToString("N0")</strong>
                    </div>
                    <a href="@Url.Action("Checkout","Cart")" class="buy-btn" style="display:block;text-align:center;padding:14px;text-decoration:none;font-size:15px;">
                        PROCEED TO CHECKOUT
                    </a>
                </div>
            </div>
        </div>
    }
</div>
