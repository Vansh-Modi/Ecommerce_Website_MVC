<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ShowsGarage.Web_Files.Master_Pages.Pages.Site" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Vansh Modi" />
    <meta name="designer" content="Vansh Modi" />
    
    <!-- Injection Guard: Instant script execution prevents screen flash before page rendering -->
    <script type="text/javascript">
        (function () {
            var savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>

    <link href="../Styles/siteMaster.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/Web_Files/Images/icons/Show's Garage Logo BG.png" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="masterPage" runat="server">
        <div class="wrapper">
            <header>
                <div id="nav-bar">
                    <div class="header-top">
                        <div id="logo-section">
                            <asp:ImageButton ID="ibLogo" runat="server" CssClass="logo-img" CausesValidation="False" OnClick="ibLogo_Click" />
                        </div>

                        <!-- INTERACTABLE SEARCH BAR -->
                        <div id="search-bar">
                            <asp:TextBox ID="txtSearch" runat="server" placeholder="Search car..." AutoPostBack="false"></asp:TextBox>
                            <asp:ImageButton ID="imgSearch" runat="server" ImageUrl="~/Web_Files/Images/icons/search-icon.png" CssClass="search-icon" ImageAlign="Middle" OnClick="imgSearch_Click" CausesValidation="false" />
                        </div>

                        <div id="utility-buttons">
                            <asp:Panel ID="Panel1" runat="server" CssClass="icon-group">
                                <!-- Inline pill switch for standard users -->
                                <div class="theme-switch-wrapper">
                                    <button type="button" class="sliding-toggle-btn" aria-label="Toggle Theme">
                                        <span class="toggle-slider"></span>
                                        <span class="toggle-icon sun-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                                        </span>
                                        <span class="toggle-icon moon-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                                        </span>
                                    </button>
                                </div>
                                <asp:ImageButton ID="ibUserCart" runat="server" ImageUrl="~/Web_Files/Images/icons/cart-icon.png" CssClass="nav-icon" EnableViewState="False" PostBackUrl="~/Web_Files/Client/Pages/cart.aspx" CausesValidation="False" />
                                <asp:ImageButton ID="ibUserAccount" runat="server" ImageUrl="~/Web_Files/Images/icons/account-icon.png" CssClass="nav-icon" PostBackUrl="~/Web_Files/Client/Pages/profile.aspx" CausesValidation="False" />
                                <asp:ImageButton ID="ibUserLogout" runat="server" ImageUrl="~/Web_Files/Images/icons/logout.png" CssClass="nav-icon" OnClick="ibUserLogout_Click" CausesValidation="False" />
                            </asp:Panel>

                            <asp:Panel ID="Panel2" runat="server" Visible="false" CssClass="icon-group">
                                <!-- Inline pill switch replicated for administrators -->
                                <div class="theme-switch-wrapper">
                                    <button type="button" class="sliding-toggle-btn" aria-label="Toggle Theme">
                                        <span class="toggle-slider"></span>
                                        <span class="toggle-icon sun-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                                        </span>
                                        <span class="toggle-icon moon-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                                        </span>
                                    </button>
                                </div>
                                <asp:ImageButton ID="ibAdminAccount" runat="server" ImageUrl="~/Web_Files/Images/icons/account-icon.png" CssClass="nav-icon" PostBackUrl="~/Web_Files/Client/Pages/profile.aspx" CausesValidation="False" />
                                <asp:ImageButton ID="ibAdminLogout" runat="server" ImageUrl="~/Web_Files/Images/icons/logout.png" CssClass="nav-icon" OnClick="ibAdminLogout_Click" CausesValidation="False" />
                            </asp:Panel>
                        </div>
                    </div>
                </div>

                <div class="header-bottom">
                    <asp:Panel ID="pnlUserNav" runat="server">
                        <nav id="user-nav">
                            <ul>
                                <li><a href="../../../homePage.aspx">Home</a></li>
                                <li><a href="../../../Web_Files/Client/Pages/shop.aspx">Collections</a></li>
                                <li><a href="../../../Web_Files/Client/Pages/myOrders.aspx">Orders</a></li>
                                <li><a href="../../../Web_Files/Client/Pages/cart.aspx">Cart</a></li>
                            </ul>
                        </nav>
                    </asp:Panel>

                    <asp:Panel ID="pnlAdminNav" runat="server" Visible="false">
                        <nav id="admin-nav">
                            <ul>
                                <li><a href="../../../Web_Files/Admin/Pages/orders.aspx">Orders</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/products.aspx">Inventory</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/users.aspx">Users</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/blog.aspx">Blog</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/siteSettings.aspx">Site Settings</a></li>
                            </ul>
                        </nav>
                    </asp:Panel>
                </div>
            </header>

            <div class="main-container">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>

            <footer>
                <div class="footer-content">
                    <div class="footer-section">
                        <h4 class="gold-text"><asp:Literal ID="litFooterBrandTitle" runat="server"></asp:Literal></h4>
                        <p>Your premium destination for precision collectibles.</p>
                    </div>
                    <div class="footer-section">
                        <h4>Policies</h4>
                        <a href="/Web_Files/Others/privacy.aspx">Privacy Policy</a>
                        <a href="/Web_Files/Others/Shipping.aspx">Shipping Info</a>
                    </div>
                    <div class="footer-section">
                        <h4>Customer Service</h4>
                        <a href="/Web_Files/Others/contactUs.aspx">Contact Us & Feedback</a>
                        <a href="/Web_Files/Others/contactUs.aspx?mode=review">Submit Product Review</a>
                        <a id="lnkFooterEmail" runat="server">Email Support</a>
                        <a id="lnkFooterPhone" runat="server">Call Us</a>
                    </div>
                    <div class="footer-section">
                        <h4>Stay Updated</h4>
                        <p>Join the garage for new case drops and exclusive diecast news.</p>
                        <div class="newsletter-container">
                            <asp:TextBox ID="txtFooterEmail" runat="server" CssClass="footer-input" placeholder="Your Email Address"></asp:TextBox>
                            <asp:LinkButton ID="btnFooterJoin" runat="server" CssClass="footer-btn" OnClick="btnFooterJoin_Click">JOIN</asp:LinkButton>
                        </div>
                    </div>
                </div>
                <div class="footer-bottom">
                    <asp:Literal ID="litCopyrightDisplay" runat="server" Mode="PassThrough"></asp:Literal>
                    | Crafted for Hobbyists <a href="/Web_Files/Master_Pages/Pages/DeveloperProfile.aspx" class="developer-link">Vansh Modi</a>
                </div>
            </footer>
        </div>
    </form>

    <script type="text/javascript">
        window.addEventListener('DOMContentLoaded', function () {
            // Native Search Keyboard Handling
            var searchTxt = document.getElementById('<%= txtSearch.ClientID %>');
            if (searchTxt) {
                searchTxt.addEventListener("keypress", function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        document.getElementById('<%= imgSearch.ClientID %>').click();
                    }
                });
            }

            // Global State Toggling Engine Mapper
            var themeButtons = document.querySelectorAll('.sliding-toggle-btn');
            themeButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', targetTheme);
                    localStorage.setItem('theme', targetTheme);
                });
            });
        });
    </script>
</body>
</html>